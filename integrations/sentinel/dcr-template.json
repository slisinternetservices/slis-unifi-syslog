                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[parameters('workspaceResourceId')]",
              "name": "workspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-UnifiSyslog"
            ],
            "destinations": [
              "workspace"
            ],
            "transformKql": "source",
            "outputStream": "Custom-UnifiSyslog_CL"
          },
          {
            "streams": [
              "Custom-UnifiCommonSecurityLog"
            ],
            "destinations": [
              "workspace"
            ],
            "transformKql": "source",
            "outputStream": "Microsoft-CommonSecurityLog"
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('servicePrincipalObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', variables('dcrName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), parameters('servicePrincipalObjectId'), variables('monitoringMetricsPublisher'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisher'))]",
        "principalId": "[parameters('servicePrincipalObjectId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "logsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2022-06-01').logsIngestion.endpoint]"
    },
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2022-06-01').immutableId]"
    },
    "customStream": {
      "type": "string",
      "value": "Custom-UnifiSyslog"
    },
    "cefStream": {
      "type": "string",
      "value": "Custom-UnifiCommonSecurityLog"
    }
  }
}
