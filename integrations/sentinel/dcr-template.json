                "type": "string"
              },
              {
                "name": "DeviceMac",
                "type": "string"
              },
              {
                "name": "DeviceVersion",
                "type": "string"
              },
              {
                "name": "Facility",
                "type": "int"
              },
              {
                "name": "Severity",
