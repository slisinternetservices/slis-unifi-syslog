      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "uss_ingest_queue_length{instance=~\"$instance\"} / uss_ingest_queue_capacity{instance=~\"$instance\"}",
