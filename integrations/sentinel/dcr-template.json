              },
              {
                "name": "OutInterface",
                "type": "string"
              },
              {
                "name": "ClientMac",
                "type": "string"
              },
              {
                "name": "ClientName",
                "type": "string"
              },
              {
                "name": "ClientIp",
                "type": "string"
              },
              {
                "name": "Ssid",
                "type": "string"
              },
              {
                "name": "Message",
                "type": "string"
              },
              {
                "name": "RawMessage",
                "type": "string"
              },
              {
                "name": "Fields",
                "type": "dynamic"
              }
            ]
          },
          "Custom-UnifiCommonSecurityLog": {
            "columns": [
              {
                "name": "TimeGenerated",
                "type": "datetime"
              },
              {
                "name": "DeviceVendor",
                "type": "string"
              },
              {
                "name": "DeviceProduct",
