          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(action IN ('block','reject')) FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote})",
          "refId": "A",
