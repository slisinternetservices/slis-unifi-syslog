              },
              {
                "name": "SeverityName",
                "type": "string"
              },
              {
                "name": "App",
                "type": "string"
              },
              {
                "name": "Category",
                "type": "string"
              },
              {
                "name": "EventType",
                "type": "string"
              },
              {
                "name": "Action",
                "type": "string"
              },
              {
                "name": "Rule",
                "type": "string"
              },
              {
                "name": "SrcIp",
                "type": "string"
              },
              {
                "name": "SrcPort",
                "type": "int"
              },
              {
                "name": "SrcCountry",
                "type": "string"
              },
              {
                "name": "SrcAsn",
                "type": "string"
              },
              {
                "name": "SrcAsOrg",
                "type": "string"
              },
              {
                "name": "SrcName",
                "type": "string"
              },
              {
                "name": "DstIp",
                "type": "string"
              },
              {
                "name": "DstPort",
                "type": "int"
              },
              {
                "name": "DstCountry",
                "type": "string"
              },
              {
                "name": "DstAsn",
                "type": "string"
              },
              {
                "name": "DstAsOrg",
