                "type": "string"
              },
              {
                "name": "SourceMACAddress",
                "type": "string"
              },
              {
                "name": "Computer",
                "type": "string"
              },
              {
                "name": "DeviceCustomString1",
                "type": "string"
              },
              {
                "name": "DeviceCustomString1Label",
                "type": "string"
              },
              {
