          "legendFormat": "queue full {{instance}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "rate(uss_kernel_udp_receive_buffer_errors_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "kernel {{instance}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "rate(uss_syslog_rejected_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "not on allowlist {{instance}}",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
