{
  "title": "UniFi Syslog Server – Logs",
  "uid": "unifi-syslog-logs",
  "tags": [
    "unifi",
    "syslog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "ClickHouse (UniFi Syslog Server)",
        "query": "grafana-clickhouse-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "type": "query",
        "name": "site",
        "label": "Site",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT toString(site) FROM logs_hourly WHERE hour > now() - INTERVAL 30 DAY ORDER BY 1",
        "definition": "SELECT DISTINCT toString(site) FROM logs_hourly",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote})",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
