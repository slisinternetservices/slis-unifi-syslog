            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "IPS alerts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ts AS time, site, src_ip, dst_ip, dst_port, fields['signature'] AS signature, fields['classification'] AS classification FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND category = 'ips' ORDER BY ts DESC LIMIT 200",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent errors",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "logs",
          "rawSql": "SELECT ts AS timestamp, concat(site, ' ', hostname, ': ', message) AS body, multiIf(severity <= 3, 'error', severity = 4, 'warning', 'info') AS level FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND severity <= 4 ORDER BY ts DESC LIMIT 500",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
