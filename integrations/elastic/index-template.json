{
  "index_patterns": [
    "logs-unifi.syslog-*"
  ],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "mapping": {
          "total_fields": {
            "limit": 2000
          }
        }
      }
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "dynamic_templates": [
        {
          "unifi_fields": {
            "path_match": "unifi.fields.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event": {
          "properties": {
            "created": {
              "type": "date"
            },
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "module": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "dataset": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "category": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "type": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "action": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "outcome": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "severity": {
              "type": "long"
            },
            "original": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            }
          }
        },
        "data_stream": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "namespace": {
              "type": "keyword"
            }
          }
        },
        "message": {
          "type": "text"
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "syslog": {
              "properties": {
                "facility": {
                  "properties": {
                    "code": {
                      "type": "long"
                    }
                  }
                },
                "severity": {
                  "properties": {
                    "code": {
                      "type": "long"
                    },
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                },
                "appname": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "procid": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "hostname": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "observer": {
          "properties": {
            "vendor": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "product": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "hostname": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "ip": {
              "type": "ip"
            },
            "mac": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "version": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "ingress": {
              "properties": {
                "interface": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            },
            "egress": {
              "properties": {
                "interface": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            }
          }
        },
        "network": {
          "properties": {
            "transport": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "rule": {
          "properties": {
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "process": {
          "properties": {
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "pid": {
              "type": "long"
            }
          }
        },
        "tags": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "unifi": {
          "properties": {
            "site": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "category": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "event_type": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "action": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "ssid": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "record_type": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "device": {
              "properties": {
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "model": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "mac": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "client": {
              "properties": {
                "mac": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ip": {
                  "type": "ip"
                }
              }
            },
            "fields": {
              "type": "object",
              "dynamic": true
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "geo": {
              "properties": {
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "geo": {
              "properties": {
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "UniFi syslog events in Elastic Common Schema, forwarded by UniFi Syslog Server",
    "managed_by": "unifi-syslog-server"
  }
}
