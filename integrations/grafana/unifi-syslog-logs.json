    {
      "id": 5,
      "type": "timeseries",
      "title": "Events per category",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, toString(category) AS category, count() AS events FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) GROUP BY time, category ORDER BY time",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Top blocked sources",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT src_ip AS source, count() AS blocks FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND action IN ('block','reject') AND src_ip != '' GROUP BY source ORDER BY blocks DESC LIMIT 15",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Top blocked destination ports",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(dst_port) AS port, count() AS blocks FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND action IN ('block','reject') AND dst_port > 0 GROUP BY port ORDER BY blocks DESC LIMIT 15",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Blocks by country",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(fields['src_country'] = '', 'unknown', fields['src_country']) AS country, count() AS blocks FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND action IN ('block','reject') GROUP BY country ORDER BY blocks DESC LIMIT 10",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Wi-Fi connections and disconnections",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
