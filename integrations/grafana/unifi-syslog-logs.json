          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, toString(event_type) AS event, count() AS events FROM logs WHERE $__timeFilter(ts) AND site IN (${site:singlequote}) AND category = 'wifi' AND event_type != '' GROUP BY time, event ORDER BY time",
          "refId": "A",
          "pluginVersion": "4.0.0"
        }
